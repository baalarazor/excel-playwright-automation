# Copy to config/test.env. Never commit real credentials.
MS_USERNAME=automation-account@example.com
MS_PASSWORD=replace-me

# Use a dedicated, editable workbook. Personal OneDrive and SharePoint URLs are supported.
EXCEL_WORKBOOK_URL=https://onedrive.live.com/edit.aspx?resid=replace-me

# Deterministic browser and date settings.
EXCEL_LOCALE=en-US
EXCEL_TIME_ZONE=Europe/Berlin
EXCEL_TARGET_CELL=A2

# Bounded waits in milliseconds.
NAVIGATION_TIMEOUT_MS=60000
ACTION_TIMEOUT_MS=15000
WORKBOOK_TIMEOUT_MS=90000
API_RESPONSE_BUDGET_MS=15000

# Set true only when the account has no MFA/Conditional Access interruption.
MS_STAY_SIGNED_IN=false
